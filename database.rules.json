{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admins": {
      ".read": true,
      ".write": false
    },
    "invites": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$mode": {
        "$rid": {
          ".read": "auth != null && root.child($mode).child('raids').child($rid).child('lead').child('uid').val() === auth.uid",
          ".write": "auth != null && root.child($mode).child('raids').child($rid).child('lead').child('uid').val() === auth.uid"
        }
      }
    },
    "joins": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$mode": {
        "$rid": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val() === root.child('invites').child($mode).child($rid).child('code').val()"
          }
        }
      }
    },
    "feedback": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$id": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.exists()))",
          ".validate": "newData.hasChildren(['kind', 'body', 't']) && newData.child('body').isString() && newData.child('body').val().length <= 1000"
        }
      }
    },
    "coop": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "raids": {
        "$rid": {
          "uids": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (root.child('coop/raids').child($rid).child('private').val() !== true || root.child('joins/coop').child($rid).child($uid).val() === root.child('invites/coop').child($rid).child('code').val()) || (auth != null && !newData.exists() && (auth.uid === $uid || root.child('coop/raids').child($rid).child('lead/uid').val() === auth.uid))"
            }
          },
          "members": {
            ".write": "auth != null && (root.child('coop/raids').child($rid).child('uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)"
          },
          "lead": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || data.child('uid').val() === auth.uid || (!data.child('name').exists() && newData.child('uid').val() === auth.uid && root.child('coop/raids').child($rid).child('uids').child(auth.uid).exists()))"
          },
          "roster": {
            "$m": {
              ".write": "(auth != null && (root.child('coop/raids').child($rid).child('uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)) || (auth != null && auth.token.firebase.sign_in_provider === 'anonymous')"
            }
          }
        }
      },
      "events": {
        "$rid": {
          ".write": "(auth != null && (root.child('coop/raids').child($rid).child('uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)) || (auth != null && auth.token.firebase.sign_in_provider === 'anonymous')"
        }
      },
      "ladder": {
        ".write": "auth != null"
      },
      "collector": {
        ".write": "auth != null"
      }
    },
    "versus": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "raids": {
        "$rid": {
          "uids": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (root.child('versus/raids').child($rid).child('private').val() !== true || root.child('joins/versus').child($rid).child($uid).val() === root.child('invites/versus').child($rid).child('code').val()) || (auth != null && !newData.exists() && (auth.uid === $uid || root.child('versus/raids').child($rid).child('lead/uid').val() === auth.uid))"
            }
          },
          "members": {
            ".write": "auth != null && (root.child('versus/raids').child($rid).child('uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)"
          },
          "lead": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || data.child('uid').val() === auth.uid || (!data.child('name').exists() && newData.child('uid').val() === auth.uid && root.child('versus/raids').child($rid).child('uids').child(auth.uid).exists()))"
          },
          "roster": {
            "$m": {
              ".write": "(auth != null && (root.child('versus/raids').child($rid).child('uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)) || (auth != null && auth.token.firebase.sign_in_provider === 'anonymous')"
            }
          }
        }
      },
      "events": {
        "$rid": {
          ".write": "(auth != null && (root.child('versus/raids').child($rid).child('uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)) || (auth != null && auth.token.firebase.sign_in_provider === 'anonymous')"
        }
      },
      "ladder": {
        ".write": "auth != null"
      },
      "collector": {
        ".write": "auth != null"
      }
    }
  }
}
