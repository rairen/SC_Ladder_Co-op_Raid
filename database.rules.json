{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admins": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "coop": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "raid": {
        "members": {
          ".write": "auth != null"
        },
        "roster": {
          "$m": {
            ".write": "auth != null"
          }
        }
      },
      "events": {
        ".write": "auth != null"
      },
      "ladder": {
        ".write": "auth != null"
      },
      "collector": {
        ".write": "auth != null"
      }
    },
    "versus": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "raid": {
        "members": {
          ".write": "auth != null"
        },
        "roster": {
          "$m": {
            ".write": "auth != null"
          }
        }
      },
      "events": {
        ".write": "auth != null"
      },
      "ladder": {
        ".write": "auth != null"
      },
      "collector": {
        ".write": "auth != null"
      }
    }
  }
}
