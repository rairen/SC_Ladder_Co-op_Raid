{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admins": {
      ".read": true,
      ".write": false
    },
    "invites": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "joins": {
      "$mode": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val() === root.child('invites').child($mode).child('code').val()"
        }
      }
    },
    "coop": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "raid": {
        "uids": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('joins/coop').child($uid).val() === root.child('invites/coop/code').val()"
          }
        },
        "members": {
          ".write": "auth != null && (root.child('coop/raid/uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)"
        },
        "roster": {
          "$m": {
            ".write": "(auth != null && (root.child('coop/raid/uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)) || (auth != null && auth.token.firebase.sign_in_provider === 'anonymous')"
          }
        }
      },
      "events": {
        ".write": "(auth != null && (root.child('coop/raid/uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)) || (auth != null && auth.token.firebase.sign_in_provider === 'anonymous')"
      },
      "ladder": {
        ".write": "auth != null"
      },
      "collector": {
        ".write": "auth != null"
      }
    },
    "versus": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "raid": {
        "uids": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('joins/versus').child($uid).val() === root.child('invites/versus/code').val()"
          }
        },
        "members": {
          ".write": "auth != null && (root.child('versus/raid/uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)"
        },
        "roster": {
          "$m": {
            ".write": "(auth != null && (root.child('versus/raid/uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)) || (auth != null && auth.token.firebase.sign_in_provider === 'anonymous')"
          }
        }
      },
      "events": {
        ".write": "(auth != null && (root.child('versus/raid/uids').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)) || (auth != null && auth.token.firebase.sign_in_provider === 'anonymous')"
      },
      "ladder": {
        ".write": "auth != null"
      },
      "collector": {
        ".write": "auth != null"
      }
    }
  }
}
